<?xml version="1.0" encoding="utf-8"?>
<!--
  Reading (and listening) shows the page only, plus one quiet line at the bottom: chapter and page. A tap in the middle
  of the page brings up the bars over it (back · title · 목차 · 설정 on top, the player below) at once, with no
  animation; turning a page, starting to listen or another tap in the middle puts them away.
-->
<app.voicereader.PageKeyLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/navigator"
            android:name="org.readium.r2.navigator.epub.EpubNavigatorFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:clickable="true"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/back"
                    style="@style/Widget.VoiceReader.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="서재로"
                    app:icon="@drawable/ic_back"
                    app:iconSize="26dp" />

                <TextView
                    android:id="@+id/bookTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/toc"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="목차"
                    android:textSize="15sp"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="설정"
                    android:textSize="15sp"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <View
                android:id="@+id/topBarRule"
                android:layout_width="match_parent"
                android:layout_height="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/player"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:clickable="true"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:id="@+id/playerRule"
                android:layout_width="match_parent"
                android:layout_height="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:padding="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/prev"
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="4dp"
                    android:text="이전 문장"
                    android:textSize="15sp"
                    app:icon="@drawable/ic_rewind"
                    app:iconGravity="top"
                    app:iconPadding="0dp"
                    app:iconSize="26dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/play"
                    style="@style/Widget.VoiceReader.Button.Filled"
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_marginHorizontal="10dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="4dp"
                    android:text="듣기"
                    android:textSize="15sp"
                    app:icon="@drawable/ic_play"
                    app:iconGravity="top"
                    app:iconPadding="0dp"
                    app:iconSize="26dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/next"
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="4dp"
                    android:text="다음 문장"
                    android:textSize="15sp"
                    app:icon="@drawable/ic_forward"
                    app:iconGravity="top"
                    app:iconPadding="0dp"
                    app:iconSize="26dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/footChapter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/footPosition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:singleLine="true"
            android:textSize="13sp" />
    </LinearLayout>
</app.voicereader.PageKeyLayout>
