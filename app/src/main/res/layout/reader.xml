<?xml version="1.0" encoding="utf-8"?>
<!--
  Fixed top to bottom, nothing ever slides over the page (on e-ink an overlay cut lines in half and showing/hiding it
  redrew the screen): the top bar, a rule, the page, a rule, the player. The player's buttons say what they do.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back"
            style="@style/Widget.VoiceReader.IconButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="서재로"
            app:icon="@drawable/ic_back"
            app:iconSize="28dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/bookTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chapter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textSize="15sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toc"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:paddingHorizontal="16dp"
            android:text="목차" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingHorizontal="16dp"
            android:text="설정" />
    </LinearLayout>

    <View
        android:id="@+id/topBarRule"
        android:layout_width="match_parent"
        android:layout_height="2dp" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navigator"
        android:name="org.readium.r2.navigator.epub.EpubNavigatorFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:id="@+id/playerRule"
        android:layout_width="match_parent"
        android:layout_height="2dp" />

    <LinearLayout
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/prev"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="이전 문장"
            android:textSize="15sp"
            app:icon="@drawable/ic_rewind"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconSize="28dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/play"
            style="@style/Widget.VoiceReader.Button.Filled"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="듣기"
            android:textSize="15sp"
            app:icon="@drawable/ic_play"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconSize="32dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/next"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="다음 문장"
            android:textSize="15sp"
            app:icon="@drawable/ic_forward"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconSize="28dp" />
    </LinearLayout>
</LinearLayout>
