<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing ever slides over the page (on e-ink an overlay cut lines in half and showing/hiding it redrew the screen).
  One slim bar on top: back, where you are, 듣기, 목차, 설정. The player below is there only while listening, so
  reading by eye gets the whole height. Its buttons say what they do.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back"
            style="@style/Widget.VoiceReader.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="서재로"
            app:icon="@drawable/ic_back"
            app:iconSize="24dp" />

        <TextView
            android:id="@+id/chapter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/listen"
            style="@style/Widget.VoiceReader.Button.Filled"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="10dp"
            android:text="듣기"
            android:textSize="15sp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart"
            app:iconPadding="2dp"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toc"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="10dp"
            android:text="목차"
            android:textSize="15sp"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="10dp"
            android:text="설정"
            android:textSize="15sp"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <View
        android:id="@+id/topBarRule"
        android:layout_width="match_parent"
        android:layout_height="2dp" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navigator"
        android:name="org.readium.r2.navigator.epub.EpubNavigatorFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:id="@+id/playerRule"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/prev"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="이전 문장"
            android:textSize="14sp"
            app:icon="@drawable/ic_rewind"
            app:iconGravity="top"
            app:iconPadding="0dp"
            app:iconSize="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/play"
            style="@style/Widget.VoiceReader.Button.Filled"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="일시정지"
            android:textSize="14sp"
            app:icon="@drawable/ic_pause"
            app:iconGravity="top"
            app:iconPadding="0dp"
            app:iconSize="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/next"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="다음 문장"
            android:textSize="14sp"
            app:icon="@drawable/ic_forward"
            app:iconGravity="top"
            app:iconPadding="0dp"
            app:iconSize="24dp" />
    </LinearLayout>
</LinearLayout>
